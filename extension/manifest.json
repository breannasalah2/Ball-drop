{
  "manifest_version": 3,
  "name": "Ball-drop Swipe",
  "version": "0.1.0",
  "description": "Talk, then swipe — approve · drop · next · undo. Continuity commands for Ball-drop.",
  "action": {
    "default_title": "Ball-drop Swipe",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel"],
  "host_permissions": [
    "https://khyejqvutrjwxljuhmot.supabase.co/*",
    "https://cdn.jsdelivr.net/*"
  ]
}
